&axisymmetric_core_benchmark
  ! Infrastructure/strong-scaling test, NOT a converged physical reference.
  core_label = 'hpc-fixed-map-smoke'
  spatial_mode = 'full_2d'
  half_width = 4.0
  number_of_cells = 16
  mesh_kind = 'uniform'
  trajectory_interpolation_order = 2
  active_radius = 3.0
  fine_region_half_width = 1.0
  medium_region_half_width = 2.0
  feedback_scale = 1.9285714285714286
  trajectory_maximum_step = 0.5
  minimum_substep_count = 1
  boundary_relaxation_distance = 1.75
  order_parameter_file = 'benchmarks/normal_core_2d/reference/current_new_src_T0.30_F1s5.4/op_xyz'
  current_field_file = 'benchmarks/normal_core_2d/reference/current_new_src_T0.30_F1s5.4/curr'
  radial_grid_kind = 'auto'
  gauss_file = 'benchmarks/normal_core_2d/reference/current_new_src_T0.30_F1s5.4/gauss11.dat'
  ozaki_file = 'benchmarks/normal_core_2d/reference/current_new_src_T0.30_F1s5.4/ozaki.dat'
  endpoint_policy = 'state_asymptotic'
  asymptotic_bulk_gap = 0.2799
  asymptotic_winding = 1.0
  asymptotic_fit_inner_radius = 2.0
  asymptotic_matching_radius = 2.8
  asymptotic_outer_radius = 8.0
  asymptotic_maximum_step = 0.5
  initialization_mode = 'radial_reference'
  restart_field_file = ''
  maximum_iterations = 0
  require_convergence = .false.
  checkpoint_interval = 0
/
