&axisymmetric_core_benchmark
  ozaki_mode = 'generate'
  bulk_gap_mode = 'auto'
  temperature = 0.30
  ozaki_cutoff = 50.0
  core_label = 'radial-BB-0plus-T030-Fs54'
  spatial_mode = 'radial_symmetry'
  ! 118 cells across the diameter give 60 independent nodes on [0,60].
  half_width = 60.0
  number_of_cells = 118
  mesh_kind = 'smooth'
  smooth_stretch = 3.0
  trajectory_interpolation_order = 2
  active_radius = 60.0
  fine_region_half_width = 3.0
  medium_region_half_width = 15.0
  fs1 = 5.4
  trajectory_maximum_step = 0.25
  minimum_substep_count = 1
  boundary_relaxation_distance = 1.75
  maximum_embedding_error = 1.e-12
  order_parameter_file = 'benchmarks/a_phase_core_2d/reference/current_new_src_T0.30_F1s5.4/op_xyz'
  current_field_file = 'benchmarks/a_phase_core_2d/reference/current_new_src_T0.30_F1s5.4/curr'
  radial_grid_kind = 'auto'
  gauss_file = 'benchmarks/a_phase_core_2d/reference/current_new_src_T0.30_F1s5.4/gauss11.dat'
  ozaki_file = 'benchmarks/a_phase_core_2d/reference/current_new_src_T0.30_F1s5.4/ozaki.dat'
  endpoint_policy = 'state_asymptotic'
  asymptotic_center_x = 0.0
  asymptotic_center_y = 0.0
  asymptotic_bulk_gap = 0.2799
  asymptotic_winding = 1.0
  asymptotic_fit_inner_radius = 45.0
  asymptotic_matching_radius = 55.0
  asymptotic_outer_radius = 120.0
  asymptotic_maximum_step = 0.25
  ! Fresh compact single-harmonic seed, no restart or reference-field initialization.
  seed_core_radius = 5.0
  seed_amplitude = 1.0
  initialization_mode = 'localized_0plus'
  restart_field_file = ''
  initial_perturbation_amplitude = 0.0
  maximum_iterations = 600
  convergence_tolerance = 2.e-6
  require_convergence = .false.
  iteration_method = 'bb'
  bb_curvature = 'absolute'
  bb_initial_mixing = 1.0
  bb_minimum_mixing = 0.001
  bb_maximum_mixing = 100.0
  bb_growth_limit = 0.0
  anderson_cycle_iterations = 0
  checkpoint_interval = 1
/
