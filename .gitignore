# FermiForge scratch builds, generated plots, and archived local runs.
# Canonical benchmark definitions and compact comparison reports belong under
# benchmarks/ and are intentionally tracked.
/work/
/tmp/
/runs/

# Products generated in the active transitional radial source directory.
# Suffixed historical reference datasets remain trackable.
/new_src/qcv
/new_src/qcv.
/new_src/gap
/new_src/egrid
/new_src/fort.*
/new_src/xgrid.dat
/new_src/error_log_*.dat
/new_src/op_xyz
/new_src/op_harm
/new_src/curr

# The historical source snapshots contain locally built extensionless
# executables in nested directories as well.
/new_src/**/qcv
/new_src/**/gap
/new_src/**/egrid
/new_src/**/fort.*
/new_src/**/xgrid.dat
/new_src/**/error_log_*.dat

# Local credentials and signing material must never be committed.
.env
.env.*
*.pem
*.key
*.p12
